# Local development. Set a fresh key before starting the API.
SAFELEDGER_DB=./capzoryx.sqlite3
SAFELEDGER_SIGNING_KEY=
SAFELEDGER_PUBLIC_URL=http://127.0.0.1:5173
SAFELEDGER_CORS_ORIGINS=http://127.0.0.1:5173
# Hosted deployments require both values from a newly created database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# The local parser, forecasts and loan calculator run without provider keys.
SAFELEDGER_LLM_FREE_TIER_CONFIRMED=0
SAFELEDGER_ALLOW_PAID_AI=0
